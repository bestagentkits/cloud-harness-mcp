[Unit]
Description=Cloud Harness recovery of a deploy killed by a reboot
Documentation=file:///opt/cloud-harness-mcp/repo/docs/operations.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# Present only while a deploy that stopped the release has not exited.
ConditionPathExists=/var/lib/cloud-harness/deploy-in-progress

[Service]
Type=oneshot
WorkingDirectory=/opt/cloud-harness-mcp/repo
Environment=CLOUD_HARNESS_DEPLOY_DETACHED=1
Environment=HOME=/root
ExecStart=/usr/local/sbin/cloud-harness-deploy --recover
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
