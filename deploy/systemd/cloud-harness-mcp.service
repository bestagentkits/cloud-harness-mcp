[Unit]
Description=Cloud Harness MCP
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cloud-harness-mcp/repo
Environment=CLOUD_HARNESS_ENV_FILE=/etc/cloud-harness-mcp/runtime.env
Environment=HOST_JOBS_ROOT=/var/lib/cloud-harness/jobs
Environment=HOST_STATE_ROOT=/var/lib/cloud-harness/state
Environment=HOST_ARTIFACT_ROOT=/var/lib/cloud-harness/artifacts
ExecStart=/usr/local/sbin/cloud-harness-service-compose up --remove-orphans
ExecStop=/usr/local/sbin/cloud-harness-service-compose down
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
