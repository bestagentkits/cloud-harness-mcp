# Copy to .env and replace every change-me value. Never commit real secrets.
MCP_BEARER_TOKEN=change-me-at-least-32-random-characters
RUNNER_TOKEN=change-me-independent-runner-token
OWNER_ID=owner
# owner-bearer (default) or cloudflare-access. In Access mode, remove MCP_BEARER_TOKEN.
AUTH_MODE=owner-bearer
# CLOUDFLARE_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUDIENCE=
# CLOUDFLARE_ACCESS_JWKS_URL=https://your-team.cloudflareaccess.com/cdn-cgi/access/certs
# Optional managed API-key lane. Enable all four together only in cloudflare-access mode.
# The gateway audience belongs to a separate Access application scoped to the /mcp-api-key path (its /mcp-api-key/gateway subpath included).
# API_KEY_AUTH_ENABLED=false
# API_KEY_GATEWAY_ACCESS_AUDIENCE=
# API_KEY_GATEWAY_SERVICE_SUBJECT=cf-service:base64url-cloudflare-service-token-client-id
# API_KEY_GATEWAY_PUBLIC_URL=https://api.harness.zuey.me/mcp
# Worker-only secrets CF_ACCESS_CLIENT_ID and CF_ACCESS_CLIENT_SECRET are configured with Wrangler, never here.
# Exact one-time legacy owner binding for the first Access rollout:
# ACCESS_LEGACY_OWNER_ID=owner
# ACCESS_LEGACY_ISSUER=https://your-team.cloudflareaccess.com
# ACCESS_LEGACY_SUBJECT=
# Optional audited subject-rotation mappings, supplied as strict JSON:
# ACCESS_PRINCIPAL_RELINKS=[]
API_PUBLIC_HOSTS=localhost,127.0.0.1,cloud-harness-mcp.46-250-239-227.sslip.io
API_ALLOWED_ORIGINS=https://cloud-harness-mcp.46-250-239-227.sslip.io
# Dashboard UI served at /dashboard: legacy (default) or react. Rollback: set legacy
# and restart the api service. A browser can opt in or out with /dashboard?ui=react|legacy.
# CLOUD_HARNESS_DASHBOARD_UI=legacy
API_PORT=3000
RUNNER_PORT=3001
RUNNER_URL=http://runner:3001
# MCP gateway (/mcp-gateway) downstream connection bounds and safe defaults.
# MCP_GATEWAY_TIMEOUT_MS=30000
# MCP_GATEWAY_MAX_RESPONSE_BYTES=262144
# MCP_GATEWAY_MAX_TOOLS_PER_SERVER=500
# MCP_GATEWAY_MAX_SCHEMA_BYTES=65536
# MCP_GATEWAY_MAX_CATALOG_BYTES=2097152
# MCP_GATEWAY_MAX_TRACE_ROWS=20000
# MCP_GATEWAY_MAX_CONNECTIONS=32
# Localhost, loopback, link-local, metadata, and private MCP endpoints are rejected unless
# the private-endpoint opt-in is enabled. Cleartext http endpoints additionally require both
# the insecure-http and private-endpoint opt-ins.
# Both opt-ins are refused in cloudflare-access mode; use https public endpoints there.
# MCP_GATEWAY_ALLOW_PRIVATE_ENDPOINTS=false
# MCP_GATEWAY_ALLOW_INSECURE_HTTP=false
# Downstream MCP OAuth (Cloud Harness authenticating TO a third-party MCP server; unrelated
# to the Cloudflare Access login that authenticates clients TO Cloud Harness). The redirect
# URL must be the dashboard origin plus /dashboard/mcp-oauth/callback; OAuth Connect is
# unavailable until it is set. The client metadata URL is optional: a public https URL
# serving this client's metadata document, used as client_id when the authorization server
# supports Client ID Metadata Documents. Without it, dynamic registration or a manually
# registered client is used.
# MCP_DOWNSTREAM_OAUTH_REDIRECT_URL=https://dashboard.example.com/dashboard/mcp-oauth/callback
# MCP_DOWNSTREAM_OAUTH_CLIENT_METADATA_URL=https://public.example.com/oauth/client/cloud-harness
# Dashboard webchat (Dewee). The api proxies /dashboard/api/v1/dewee/* to this gateway with the
# server-side token; the browser never sees the token or the signing secret. Set the URL, token
# and secret together, or leave all three unset to disable the webchat (typed 503). Kill switch:
# unset them and restart the api service. The api has no host mounts, so set the two secrets
# inline in the runtime env file (the _FILE variants work only where a file is mounted). The
# runner blanks them in Compose; ingress and executors never receive them.
# DEWEE_GATEWAY_URL=https://dewee-gateway.example.com
# Server-side Dewee gateway token, sent only in the gateway connect frame.
# DEWEE_GATEWAY_TOKEN=
# At least 32 random characters; signs the per-operator webchat visitor tokens.
# DEWEE_WEBCHAT_SECRET=
# The only Dewee agent the Dashboard webchat can reach.
# DEWEE_AGENT_ID=cloud-harness-operator
# Optional tenant id or slug for a multi-tenant Dewee gateway.
# DEWEE_TENANT_ID=
# Upper bound for one webchat agent run, in milliseconds (10000-600000).
# DEWEE_CHAT_TIMEOUT_MS=180000
# Model gateway provider override. When set, the gateway sends this one upstream header,
# filled with the calling agent id, to OpenAI-compatible providers that require a
# conversation identifier (for example x-opencode-session for a Custom route to OpenCode).
# A registry provider's own session header, such as OpenCode Go's, takes precedence. Unset
# sends no such header. The value must be a lowercase header name the gateway does not set itself.
# MODEL_GATEWAY_SESSION_HEADER=x-opencode-session
JOBS_ROOT=/var/lib/cloud-harness/jobs
STATE_DB=/var/lib/cloud-harness/state/cloud-harness.db
ARTIFACT_ROOT=/var/lib/cloud-harness/artifacts
MAX_ARTIFACT_BYTES=16777216
MAX_PRINCIPAL_ARTIFACT_BYTES=134217728
ARTIFACT_RETENTION_SECONDS=86400
REPO_CACHE_ROOT=/var/lib/cloud-harness/cache/repos
# ENABLE_REPO_CACHE=false
TOOLKIT_CACHE_ROOT=/var/lib/cloud-harness/cache/toolkits
# ENABLE_TOOLKIT_CACHE=true
# TOOLKIT_NETWORK_POLICY=cache-only
# Operator-provided agent skills: the single source for the `built-in` skills tier. Set to a host
# directory (absolute) and it is mounted read-only into every executor at
# /opt/cloud-harness/skills, the worker's highest-precedence tier, and rescanned by the runner from
# this same directory to attribute that partition. Content is operator-owned: the harness never
# writes to it and records its provenance as built-in. The mount target stays authoritative on the
# executor side. This name is reserved, so a workspace environment can never shadow it. Replaces the
# former CH_BUILTIN_SKILLS_ROOT override: rename that variable to this one, or move the catalog to the
# mount target. Leave unset to keep the tier empty.
# BUILTIN_SKILLS_ROOT=/var/lib/cloud-harness/skills
# Licensed AgentKit kits (toolkits: [{ kind: "agentkit", kitId: "engineer" }]).
# AGENTKIT_REGISTRY_URL=https://agentkit.best
# The secret name that holds this principal's AgentKit licence token. The token
# must start with ak_dev_ or ak_cli_ and MUST be created with purpose=provisioning,
# never runtime: runtime secrets are injected into executor environments. It is
# resolved from the dashboard secret store; without it the agentkit toolkit kind
# fails closed.
# AGENTKIT_REGISTRY_CREDENTIAL_SECRET=AGENTKIT_REGISTRY_TOKEN
# Ed25519 registry signing key id. Required before the agentkit toolkit kind is available.
# AGENTKIT_REGISTRY_KEY_ID=agentkit-registry-2026
# Ed25519 registry signing public key (PEM or base64 SPKI DER). Required before the
# agentkit toolkit kind is available; an unverified manifest is refused.
# AGENTKIT_REGISTRY_PUBLIC_KEY=<PEM or base64 SPKI DER>
EXECUTOR_IMAGE=cloud-harness-executor:local
NETWORK_GUARD_IMAGE=cloud-harness-network-guard:local
ALLOWED_GIT_HOSTS=github.com
# Executor egress for newly opened workspaces. dependency-access (default) permits public DNS
# and TCP 80/443 so the GitHub API and the bundled gh CLI work; network-none blocks all egress.
# dependency-access requires a Linux host firewall provisioned via deploy/scripts/setup-dependency-firewall.sh
# and is refused, never silently downgraded, when that firewall is not attested. The dashboard
# Settings page overrides this value for future workspaces without a redeploy.
WORKSPACE_NETWORK_PROFILE=dependency-access
# DEPENDENCY_DNS_RESOLVERS=8.8.8.8,1.1.1.1
# DEPENDENCY_BRIDGE_SUBNET=172.30.240.0/24
# DEPENDENCY_BRIDGE_INTERFACE=chm-egress0
# DEPENDENCY_NETWORK_NAME=cloud-harness-dependency-access
# Workspace lifetime defaults. Dashboard Settings > Workspace limits & lifecycle can override these
# (and MAX_ACTIVE_WORKSPACES_PER_OWNER) for newly opened workspaces without a redeploy.
WORKSPACE_WALL_TTL_SECONDS=900
# Idle timeout: a workspace without tool activity for this long expires (30..43200, always capped by the wall TTL).
WORKSPACE_IDLE_TTL_SECONDS=300
# How long an expired workspace stays recoverable before auto-close (0..86400, default 3600). 0 closes
# clean expired workspaces on the next reaper pass; work that is not pushed is always retained.
# WORKSPACE_RECOVERABLE_GRACE_SECONDS=3600
# Concurrent active workspaces allowed per principal. Defaults to 3 when unset; set 1 to restore
# single-workspace behaviour. Each counted workspace can use up to 1 GiB of container memory, one
# CPU, and 256 pids, so size host memory for this limit times the expected simultaneous builds.
MAX_ACTIVE_WORKSPACES_PER_OWNER=3
# Dashboard Terminal (runner): live PTYs one workspace may hold; another open is refused with 429.
# TERMINAL_MAX_PER_WORKSPACE=4
# Raw output bytes retained per terminal for reconnecting readers; older bytes are reported as missed.
# TERMINAL_RETAINED_BYTES=1048576
# A terminal with no input, resize, or read for this long ends as timed_out.
# TERMINAL_IDLE_TIMEOUT_MS=900000
# Absolute terminal lifetime regardless of activity.
# TERMINAL_MAX_LIFETIME_MS=28800000
# Managed toolbox (runner): enables the `bash` tool's `toolbox` target, which runs each command in a
# disposable no-network executor-image container. Off by default; the `workspace` target is unaffected.
# PACKAGES_ENABLED=false
# Maximum toolbox containers running at once on this runner; a call beyond it gets LIMIT_EXCEEDED (429, retryable).
# TOOLBOX_MAX_CONCURRENT=2
# Managed toolbox packages (runner, used only while PACKAGES_ENABLED=true). Immutable releases live here;
# Compose mounts HOST_PACKAGES_ROOT at this path and the two must be equal.
# PACKAGES_ROOT=/var/lib/cloud-harness/packages
# Ecosystems that may be planned: a comma-separated subset of npm,uv. apt always answers NOT_SUPPORTED.
# PACKAGES_ECOSYSTEMS=npm,uv
# required: each plan waits for a Dashboard approval bound to its digest (cloudflare-access mode; owner-bearer
# refuses apply). none: plans are approved by policy when created.
# PACKAGES_APPROVAL_MODE=required
# allow lets a plan that asks for npm lifecycle scripts run them in the builder; deny always skips them.
# PACKAGES_NPM_LIFECYCLE_SCRIPTS=deny
# Largest verified release tree, in bytes (16 MiB to 4 GiB).
# PACKAGES_MAX_RELEASE_BYTES=536870912
# Total retained release bytes per owner (64 MiB to 64 GiB).
# PACKAGES_MAX_OWNER_BYTES=4294967296
# Package bindings (one package in one scope) per owner.
# PACKAGES_MAX_BINDINGS=32
# Wall-clock limit for one plan or apply builder container.
# PACKAGES_BUILD_TIMEOUT_MS=600000
# Registry hosts for package builds are opted in on the provisioning proxy only, through PACKAGES_PROXY_HOSTS
# in /etc/cloud-harness-mcp/provisioning-proxy.env, never in this file; see docs/operations.md.

# Decision Plane (runner): advisory semantic decisions, sent only when the owner has a TypeSafe
# integration key. Comma-separated subset of mcp-routing,failure-classification; empty keeps it off.
# DECISION_PLANE_PURPOSES=
# Instance-wide TypeSafe egress switch (runner): off stops skill suggestions and the Decision Plane even
# when an owner has stored a key. Per owner, deleting the key does the same.
# TYPESAFE_EGRESS=on

# Managed agent session persistence (runner): agents spawned while it is on record their Pi session in the
# runner state store, and agent_spawn.continueFrom continues an ended agent's session in a new agent on the
# same model profile. Off, spawns behave as before and continueFrom is refused with NOT_SUPPORTED.
# AGENT_SESSION_PERSISTENCE_ENABLED=false
# Most messages one persisted session may hold; past it the run continues but is no longer continuable.
# AGENT_MAX_SESSION_MESSAGES=2000
# Most message bytes one persisted session may hold (at most 7864320, to fit the 8 MiB agent start record).
# AGENT_MAX_SESSION_BYTES=7340032
# How long a sealed session stays continuable after its agent ends (7 days); workspace close deletes it sooner.
# AGENT_SESSION_RETENTION_MS=604800000
# Most bytes all stored sessions of one workspace may hold together; a continuation copies its predecessor's log.
# AGENT_WORKSPACE_SESSION_BYTES=67108864
# Most bytes all stored sessions of one owner may hold together.
# AGENT_PRINCIPAL_SESSION_BYTES=536870912
# Most bytes all stored sessions of the instance may hold together (workspace <= principal <= global).
# AGENT_GLOBAL_SESSION_BYTES=1073741824
# Most stored tool-result bytes (receipts) one agent lineage may keep for replay (32 MiB); past it only hashes are kept.
# AGENT_MAX_RECEIPT_BYTES_PER_LINEAGE=33554432

# Optional GitHub App repository access; required fields depend on AUTH_MODE:
# GITHUB_APP_ID=
# Required in owner-bearer mode; omit in Access mode, where each principal binds an installation:
# GITHUB_APP_INSTALLATION_ID=
# Required in Access mode for the installation redirect:
# GITHUB_APP_SLUG=
# Optional operator-wide GitHub fallback credential, read from GH_TOKEN (preferred) then
# GITHUB_TOKEN, each also accepting a _FILE form. Used only by the runner, only when no
# GitHub App repository token can be minted, and only in owner-bearer mode: an operator-wide
# credential must never authorize a different principal. In cloudflare-access mode, create a
# per-principal global runtime secret named GH_TOKEN or GITHUB_TOKEN in the dashboard instead.
# This credential authenticates harness-side GitHub operations only and is never placed in
# executor environments. To authenticate the bundled gh CLI inside a workspace, create a
# global runtime secret named GH_TOKEN or GITHUB_TOKEN.
# GH_TOKEN=
# GITHUB_TOKEN=
# Optional Cloudflare Access Managed OAuth integration (cloudflare-access mode only). Lets
# Dashboard -> Settings read and update the inbound MCP OAuth grant session duration and
# access-token lifetime of the Access application that protects /mcp. All three identifiers are
# required together. The API token is runner-only: scope it to "Access: Apps and Policies
# Write" (or Read with CLOUDFLARE_ACCESS_OAUTH_ACCESS=read-only) and prefer the _FILE form.
# Production host file: /etc/cloud-harness-mcp/cloudflare-access-api-token
# CLOUDFLARE_ACCESS_API_TOKEN_FILE=/run/cloud-harness-secrets/cloudflare-access-api-token
# CLOUDFLARE_ACCESS_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_APP_ID=
# read-write (default) or read-only.
# CLOUDFLARE_ACCESS_OAUTH_ACCESS=read-write
# Longest grant the provider accepts, in seconds. Defaults to 2592000 (30 days).
# CLOUDFLARE_ACCESS_OAUTH_MAX_GRANT_SECONDS=2592000
# Production host file: /etc/cloud-harness-mcp/github-app-private-key.pem
# GITHUB_APP_PRIVATE_KEY_FILE=/run/cloud-harness-secrets/github-app-private-key.pem
# Versioned AES-256-GCM keyring JSON. Prefer the runner-only file form.
# SECRET_KEYRING_FILE=/run/cloud-harness-secrets/secret-keyring.json
